{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "customers": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "shipments": {
        "ClusterId": "shipment",
        "Match": { "Path": "/api/shipments/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "order",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "warehouses": {
        "ClusterId": "warehouse",
        "Match": { "Path": "/api/warehouses/{**catch-all}" }
      },
      "fleet": {
        "ClusterId": "fleet",
        "Match": { "Path": "/api/fleet/{**catch-all}" }
      },
      "drivers": {
        "ClusterId": "driver",
        "Match": { "Path": "/api/drivers/{**catch-all}" }
      },
      "routes": {
        "ClusterId": "routing",
        "Match": { "Path": "/api/routes/{**catch-all}" }
      },
      "tracking": {
        "ClusterId": "tracking",
        "Match": { "Path": "/api/tracking/{**catch-all}" }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/billing/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "reports": {
        "ClusterId": "reporting",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:5001"
          }
        }
      },
      "customer": {
        "Destinations": {
          "customer": {
            "Address": "http://customer:5002"
          }
        }
      },
      "shipment": {
        "Destinations": {
          "shipment": {
            "Address": "http://shipment:5003"
          }
        }
      },
      "order": {
        "Destinations": {
          "order": {
            "Address": "http://order:5004"
          }
        }
      },
      "warehouse": {
        "Destinations": {
          "warehouse": {
            "Address": "http://warehouse:5005"
          }
        }
      },
      "fleet": {
        "Destinations": {
          "fleet": {
            "Address": "http://fleet:5006"
          }
        }
      },
      "driver": {
        "Destinations": {
          "driver": {
            "Address": "http://driver:5007"
          }
        }
      },
      "routing": {
        "Destinations": {
          "routing": {
            "Address": "http://routing:5008"
          }
        }
      },
      "tracking": {
        "Destinations": {
          "tracking": {
            "Address": "http://tracking:5009"
          }
        }
      },
      "billing": {
        "Destinations": {
          "billing": {
            "Address": "http://billing:5010"
          }
        }
      },
      "notification": {
        "Destinations": {
          "notification": {
            "Address": "http://notification:5011"
          }
        }
      },
      "reporting": {
        "Destinations": {
          "reporting": {
            "Address": "http://reporting:5012"
          }
        }
      }
    }
  }
}
